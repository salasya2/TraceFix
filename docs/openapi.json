  "components": {
    "schemas": {
      "ApproveBody": {
        "properties": {
          "patch_digest": {
            "type": "string",
            "title": "Patch Digest"
          }
        },
        "type": "object",
        "required": [
          "patch_digest"
        ],
        "title": "ApproveBody"
      },
      "DevLogin": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          }
        },
        "type": "object",
        "required": [
          "email"
        ],
        "title": "DevLogin"
      },
      "EmergencyBody": {
        "properties": {
          "engaged": {
            "type": "boolean",
            "title": "Engaged",
            "default": true
          }
        },
        "type": "object",
        "title": "EmergencyBody"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ManualInvestigation": {
        "properties": {
          "github_run_id": {
            "type": "integer",
            "title": "Github Run Id"
          },
          "github_attempt": {
            "type": "integer",
            "title": "Github Attempt",
            "default": 1
          },
          "source_sha": {
            "type": "string",
            "title": "Source Sha"
          },
          "execution_sha": {
            "type": "string",
            "title": "Execution Sha"
          },
          "base_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Sha"
          }
        },
        "type": "object",
        "required": [
          "github_run_id",
          "source_sha",
          "execution_sha"
        ],
        "title": "ManualInvestigation"
      },
      "OIDCFinish": {
        "properties": {
          "issuer": {
            "type": "string",
            "title": "Issuer"
          },
          "audience": {
            "type": "string",
            "title": "Audience"
          },
          "nonce": {
            "type": "string",
            "title": "Nonce"
          },
          "claims": {
            "type": "object",
            "title": "Claims"
          }
        },
        "type": "object",
        "required": [
          "issuer",
          "audience",
          "nonce",
          "claims"
        ],
        "title": "OIDCFinish"
      },
      "PolicyUpdate": {
        "properties": {
          "document": {
            "type": "object",
            "title": "Document"
          },
          "expected_version": {
            "type": "integer",
            "title": "Expected Version"
          }
        },
        "type": "object",
        "required": [
