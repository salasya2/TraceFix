# TraceFix local configuration. Copy to .env and fill in secrets.
# Never put secrets in GitHub checkouts, model prompts, sandboxes, or logs.

TRACEFIX_ENV=development
TRACEFIX_PROFILE=embedded
TRACEFIX_LOG_LEVEL=INFO
TRACEFIX_AUTH_MODE=dev
TRACEFIX_SECRET_KEY=replace-with-32-byte-urlsafe-secret
TRACEFIX_DEV_USER_EMAIL=maintainer@tracefix.local
TRACEFIX_DEV_USER_ROLE=owner

# HTTP
TRACEFIX_API_HOST=127.0.0.1
TRACEFIX_API_PORT=8080
TRACEFIX_PUBLIC_URL=http://127.0.0.1:8080
TRACEFIX_WEB_ORIGIN=http://127.0.0.1:5173

# Persistence (embedded demo uses SQLite; compose uses Postgres)
DATABASE_URL=sqlite+aiosqlite:///./.data/tracefix.db
# DATABASE_URL=postgresql+asyncpg://tracefix:tracefix@127.0.0.1:5432/tracefix

# Artifacts: local disk or S3-compatible
TRACEFIX_ARTIFACT_BACKEND=local
TRACEFIX_ARTIFACT_DIR=./.data/artifacts
# TRACEFIX_ARTIFACT_BACKEND=s3
# AWS_ENDPOINT_URL=http://127.0.0.1:9000
# AWS_ACCESS_KEY_ID=minio
# AWS_SECRET_ACCESS_KEY=minio-password
# TRACEFIX_S3_BUCKET=tracefix-artifacts

# Orchestration
TRACEFIX_ORCHESTRATOR=local
# TRACEFIX_ORCHESTRATOR=temporal
# TEMPORAL_ADDRESS=127.0.0.1:7233
# TEMPORAL_NAMESPACE=tracefix

# Executor
TRACEFIX_EXECUTOR=process
# TRACEFIX_EXECUTOR=docker
TRACEFIX_DOCKER_NETWORK=none
TRACEFIX_PYTHON_BIN=python

# Model provider. fixture = labeled simulated agent for owned tasks.
# spacexai uses XAI_API_KEY against https://api.x.ai/v1
# anthropic uses ANTHROPIC_API_KEY
TRACEFIX_MODEL_PROVIDER=fixture
TRACEFIX_MODEL_ID=grok-4.5
TRACEFIX_PROMPT_VERSION=v1
XAI_API_KEY=
ANTHROPIC_API_KEY=
TRACEFIX_MODEL_BASE_URL=https://api.x.ai/v1

# GitHub App (required for live ingestion/publication; fixture used in demo)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=dev-webhook-secret-change-me
GITHUB_API_VERSION=2022-11-28
GITHUB_API_URL=https://api.github.com

# OIDC (compose/staging). Dev auth skips this.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=tracefix

# Budgets
TRACEFIX_DEFAULT_RESERVED_MODEL_USD=2.00
TRACEFIX_GLOBAL_MAX_CONCURRENT_RUNS=20
